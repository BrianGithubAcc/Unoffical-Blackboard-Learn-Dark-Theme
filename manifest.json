{
  "manifest_version": 3,
  "name": "Blackboard Learn Dark Theme",
  "version": "1.0.0",
  "description": "A comfortable dark theme for Blackboard Learn, enabled per tab.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Toggle Blackboard dark theme",
    "default_popup": "popup.html",
    "default_icon": "icons/moon.svg"
  },
  "icons": {
    "48": "icons/moon.svg",
    "96": "icons/moon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "blackboard-dark-theme@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
